{{ 'main-product.css' | asset_url | stylesheet_tag }}
{{ 'main-product-info.css' | asset_url | stylesheet_tag }}

{% assign nivel_resistencia = product.metafields.custom.nivel_de_resistencia %}
{% assign cupons = product.metafields.custom.cupons_de_desconto.value %}
{% assign modelo = product.metafields.custom.modelo %}
{% assign marca = product.metafields.custom.marca %}
{% assign compre_junto = product.metafields.custom.compre_junto %}
{% assign especificacao_tecnica = product.metafields.custom.especificacao_tecnica %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-panel {
    width: 100%;
    max-width: none;
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-sizing: border-box;
  }

  .section-{{ section.id }}-padding #product .right-side-product #more-payments {
    width: 100%;
    max-width: none;
    margin: 0;
    box-sizing: border-box;
  }

  .section-{{ section.id }}-padding #product .right-side-product #more-payments > ul {
    width: 100%;
    margin: 0;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .section-{{ section.id }}-padding #product .right-side-product #more-payments .more-pay {
    margin-left: auto;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-actions {
    width: 100%;
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-sizing: border-box;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-actions .buy-area,
  .section-{{ section.id }}-padding #product .right-side-product .purchase-actions .buy-button {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-actions .buy-area {
    display: block;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-actions .buy-button > button {
    width: 100%;
    margin: 0;
    box-sizing: border-box;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-actions .compra-segura {
    width: 100%;
    max-width: none;
    min-height: 0;
    height: auto;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    text-align: center;
    box-sizing: border-box;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-actions .compra-segura p {
    margin: 0;
    padding: 0;
    font-size: 13px;
    line-height: 1.4;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-actions .compra-segura .svg-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-actions .compra-segura svg {
    width: 100%;
    height: 100%;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-panel .shipping-calc {
    width: 100%;
    max-width: none;
    margin: 0;
    box-sizing: border-box;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-panel .shipping-calc > p {
    margin: 0 0 10px;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-panel .shipping__form {
    display: block;
    width: 100%;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-panel .shipping__form > .wrapper {
    display: flex;
    width: 100%;
    max-width: 340px;
    margin-left: 0;
    margin-right: auto;
    gap: 12px;
    align-items: stretch;
    box-sizing: border-box;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-panel .shipping__form .js-zip {
    flex: 1 1 0;
    width: 0;
    min-width: 0;
    max-width: none;
    box-sizing: border-box;
  }

  .section-{{ section.id }}-padding #product .right-side-product .purchase-panel .shipping__form .js-button {
    flex: 0 0 auto;
    width: auto;
    white-space: nowrap;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }}-padding #product .right-side-product .purchase-actions {
      max-width: 320px;
      margin-left: auto;
      margin-right: 0;
    }
  }

  .triangle {
    left: calc((20.16px * {{ nivel_resistencia | minus: 1 }}) + 2.76px);
  }
{%- endstyle -%}

<div class="page-width">
  {% render 'breadcrumb', collection_name: product.title %}
</div>

<div class="page-width section-{{ section.id }}-padding">
  <div id="product">
    <div class="wrapper-product">
      <div class="left-side-product">
        <div class="product-media">
          <div class="wishlist">
            <wishlist-btn data-product-handle="{{ product.handle }}">
              <span class="svg-wrapper">
                {{- 'wishlist-icon.svg' | inline_asset_content -}}
              </span>
            </wishlist-btn>
          </div>

          {% render 'product-main-media', product: product %}

          {% if nivel_resistencia != blank %}
            <div class="nivel-resistencia">
              <p>Nível de resistência</p>

              <div class="wrapper">
                <div class="wrapper-svg">
                  {{- 'nivel-resistencia.svg' | inline_asset_content -}}
                </div>

                <div class="triangle">
                  <div class="svg-wrapper small">
                    {{- 'triangle.svg' | inline_asset_content -}}
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        </div>

        {% if compre_junto %}
          <div class="desktop">
            {% render 'buy-together', compre_junto: compre_junto %}
          </div>
        {% endif %}

        <div class="desktop">
          {% render 'product-extra-info',
            description: product.description,
            especificacao_tecnica: especificacao_tecnica
          %}
        </div>
      </div>

      <div class="right-side-product">
        {% render 'cupons-area', cupons: cupons %}

        <div class="title-product">
          <h1>{{ product.title }}</h1>
        </div>

        <div class="brand-code-model-product">
          <div class="code">
            <p>
              Código:
              <span>{{ product.selected_or_first_available_variant.sku }}</span>
            </p>
          </div>

          {% if modelo != blank %}
            <div class="model">
              <p>
                Módelo:
                <span>
                  {{ modelo }}
                </span>
              </p>
            </div>
          {% endif %}

          {% if marca != blank %}
            <div class="brand">
              <p>
                Marca:
                <span>
                  {{ marca }}
                </span>
              </p>
            </div>
          {% endif %}
        </div>

        <div class="app-full-desk">
          {% for block in section.blocks %}
            {% if block.type == '@app' %}
              {% render block %}
            {% endif %}
          {% endfor %}

          <a class="desktop" href="#descricao-completa">
            Ver descrição completa
          </a>
        </div>

        <div class="price-area">
          {% render 'price-product', product: product %}
        </div>

        <div class="purchase-panel">
          <div id="more-payments">
            <ul>
              <li>
                {% render 'pay-1-pdp' %}
              </li>

              <li>
                {% render 'pay-2-pdp' %}
              </li>

              <li>
                {% render 'pay-3-pdp' %}
              </li>

              <li>
                {% render 'pay-4-pdp' %}
              </li>

              <li class="more-pay">
                <p class="">
                  <span>mais formas de pagamento</span>
                </p>
                {% render 'r-arrow-b' %}
              </li>
            </ul>
          </div>

          {% if product.variants.size > 1 %}
            <div class="variants">
              {% for option in product.options_with_values %}
                <legend>
                  {% if option.name == 'Voltagem' %}
                    Escolha a voltagem:
                  {% else %}
                    {{ option.name }}
                  {% endif %}
                </legend>

                <fieldset is="variant-options" class="variants-fieldset">
                  <div class="options-wrapper">
                    {% for value in option.values %}
                      <div class="wrapper-op">
                        <label
                          class="option-label"
                          for="{{ option.name | handleize }}-{{ value | handleize }}"
                          {% if value.variant.inventory_quantity == 0 %}
                            data-disabled="true"
                          {% endif %}
                        >
                          {{ value }}
                        </label>

                        <input
                          type="radio"
                          name="{{ option.name | handle }}"
                          value="{{ value.variant.url }}"
                          class="hidden"
                          id="{{ option.name | handleize }}-{{ value | handleize }}"
                        >
                      </div>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endfor %}
            </div>
          {% endif %}

          <div class="purchase-actions">
            <div class="buy-area">
              {%- assign product_form_id = 'product-form-' | append: section.id -%}

              {% render 'buy-button',
                product: product,
                product_form_id: product_form_id,
                section_id: section.id,
                buy_label: 'Comprar'
              %}
            </div>

            <div class="compra-segura">
              <span class="svg-wrapper">
                {{- 'security-green.svg' | inline_asset_content -}}
              </span>
              <p>Compra segura</p>
            </div>
          </div>

          {% render 'shipping-calc' %}
        </div>
      </div>
    </div>

    {% if compre_junto %}
      <div class="mobile">
        {% render 'buy-together', compre_junto: compre_junto %}
      </div>
    {% endif %}

    <div class="mobile">
      {% render 'product-extra-info',
        description: product.description,
        especificacao_tecnica: especificacao_tecnica
      %}
    </div>

    {% render 'payment-methods-product' %}
  </div>
</div>

{% javascript %}
  document.getElementById('more-payments').addEventListener('click', function () {
    document.querySelector('.paymethods_product').classList.add('active');
  });

  document.querySelector('.paymethods_product span').addEventListener('click', function () {
    document.querySelector('.paymethods_product').classList.remove('active');
  });
{% endjavascript %}

<script src="{{ 'main-product.js' | asset_url }}" defer></script>
<script src="{{ 'zoom-main-image.js' | asset_url }}" defer></script>
<script src="{{ 'wishlist.js' | asset_url }}" defer></script>
<script src="{{ 'shipping-calculator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "revendedor",
      "label": "Texto Revendedor",
      "default": "Seja um revendedor "
    },
    {
      "type": "url",
      "id": "link_revendedor",
      "label": "Link revendedor"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
